# AI解説（Claude API）に使用。Vercel の Environment Variables に設定する
ANTHROPIC_API_KEY=

# 端末間同期（Supabase Auth + study_progress テーブル）
NEXT_PUBLIC_SUPABASE_URL=https://jbpycgooqesjxkonxqiy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- 運用者用管理画面（/admin）----
# Supabase のプロジェクト URL と service_role キー（Project Settings → API）。サーバー側だけで使う
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Google ログイン（Google Cloud Console → API とサービス → 認証情報 → OAuth クライアント ID「ウェブアプリケーション」）
# 承認済みのリダイレクト URI: https://app.cybershield.jp/api/admin/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ログインを許可する Google Workspace のドメイン（カンマ区切り。既定: dropstone.co.jp）
ADMIN_ALLOWED_DOMAINS=dropstone.co.jp
# 任意: ドメイン外で個別に許可するメールアドレス（カンマ区切り）
ADMIN_ALLOWED_EMAILS=
# セッション署名用の秘密値（長くランダムなもの。例: openssl rand -hex 32）。変更すると全セッション失効
ADMIN_SESSION_SECRET=
# 任意: 予備のパスワードログイン。空ならパスワードログインは無効（Google のみ）
ADMIN_PASSWORD=
# 任意: リダイレクト URI の生成に使う公開 URL（未設定ならアクセスされたホスト）
ADMIN_BASE_URL=
